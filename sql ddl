-- Creacion de datos y sus respectivas restricciones

CREATE TYPE tipo_empleado AS ENUM ('gerente', 'limpieza',
'atencion_al_cliente');

CREATE DOMAIN email AS VARCHAR(255)
    CHECK (VALUE ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$');

CREATE TYPE tipo_sala AS ENUM ('2D', '3D','IMAX');

CREATE TYPE clasificacion_pelicula AS ENUM 
('ATP', 'P-13','P-16','P-18','P-21');

CREATE TYPE tipo_publicidad AS ENUM 
('trailer', 'publicidad_negocio','promocion_sucursal');

CREATE TYPE tipo_entrada AS ENUM ('kiosko', 'online');

CREATE DOMAIN ean13 AS BIGINT CHECK(VALUE BETWEEN 0 AND 9999999999999);

-- creacion de tablas

CREATE TABLE sucursal (
	id_sucursal INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	nombre VARCHAR(40) NOT NULL UNIQUE CHECK (nombre <> ''),
	telefono VARCHAR(20), 
	ciudad VARCHAR(20) NOT NULL,
	calle VARCHAR(40) NOT NULL,
	numero_de_calle SMALLINT NOT NULL  CHECK (numero_de_calle > 0)
);


CREATE TABLE empleado (
	legajo INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	dni INTEGER NOT NULL UNIQUE CHECK (dni > 0),
	id_sucursal INTEGER NOT NULL,
	CONSTRAINT empleado_sucursal_fk FOREIGN KEY (id_sucursal) REFERENCES
	sucursal(id_sucursal) ON UPDATE CASCADE ON DELETE RESTRICT,
	/* si existen empleados, no se puede eliminar la sucursal */
	empleado tipo_empleado NOT NULL,
	nombre VARCHAR(20) NOT NULL,
	apellido VARCHAR(30) NOT NULL,
	telefono VARCHAR(20) NOT NULL,
	mail email NOT NULL,
	calle VARCHAR(40) NOT NULL,
	numero SMALLINT NOT NULL  CHECK (numero > 0),
	codigo_postal VARCHAR(10) 
);

CREATE TABLE sala(
	nro_sala INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
	id_sucursal INTEGER NOT NULL,
	CONSTRAINT sala_sucursal_fk FOREIGN KEY (id_sucursal) REFERENCES
	sucursal(id_sucursal) ON UPDATE CASCADE ON DELETE CASCADE,
	/* si se elimina la sucursal, se eliminan sus salas */
	cant_asientos SMALLINT NOT NULL CHECK (cant_asientos > 0),
	sala tipo_sala NOT NULL
);

CREATE TABLE proveedor (
	id_proveedor INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
	cuit BIGINT NOT NULL UNIQUE,
	mail email NOT NULL,
	nombre VARCHAR(30) NOT NULL,
	descripcion VARCHAR(60)
);

CREATE TABLE kiosko (
	id_kiosko INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	id_sucursal INTEGER NOT NULL,
	CONSTRAINT kiosko_sucursal_fk FOREIGN KEY (id_sucursal) REFERENCES
	sucursal(id_sucursal) ON UPDATE CASCADE ON DELETE CASCADE,
	/*si se elimina la sucursal, se elimina el kiosko*/
	UNIQUE(id_kiosko,id_sucursal)
);


CREATE TABLE articulo (
	id_articulo INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	codigo ean13 NOT NULL UNIQUE,
	nombre VARCHAR(50) NOT NULL,
	precio float NOT NULL CHECK(precio > 0)
);

CREATE TABLE cliente (
	id_cliente INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	dni INTEGER NOT NULL UNIQUE CHECK (dni > 0),
	mail email NOT NULL
);


CREATE TABLE publicidad (
	id_publicidad INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	duracion TIME NOT NULL,
	clasificacion clasificacion_pelicula NOT NULL,
	publicidad tipo_publicidad NOT NULL	
);

CREATE TABLE espacio_publicitario (
	cod_espacio_publicitario INTEGER 
	GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	clasificacion clasificacion_pelicula NOT NULL,
	duracion TIME DEFAULT '00:00:00'
);

CREATE TABLE cartelera (
	codigo_cartelera INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	fecha DATE NOT NULL DEFAULT CURRENT_DATE
);

CREATE TABLE pelicula (
	codigo_pelicula INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	titulo VARCHAR(50) NOT NULL UNIQUE,
	genero VARCHAR(15),
	trailer TIME NOT NULL,
	sinopsis VARCHAR(255) CHECK(sinopsis <> ''),
	duracion TIME NOT NULL,
	clasificacion clasificacion_pelicula NOT NULL
);

CREATE TABLE horario (
	id_horario INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	codigo_pelicula INTEGER NOT NULL,
	codigo_cartelera INTEGER NOT NULL,
	CONSTRAINT horario_pelicula_fk FOREIGN KEY (codigo_pelicula)
	REFERENCES pelicula(codigo_pelicula)
	ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT horario_cartelera_fk FOREIGN KEY (codigo_cartelera)
	REFERENCES cartelera(codigo_cartelera)
	ON UPDATE CASCADE ON DELETE CASCADE,
	hora_inicio TIME NOT NULL,
	hora_fin TIME DEFAULT '00:00:00',
	UNIQUE(id_horario,codigo_pelicula,codigo_cartelera)
);


CREATE TABLE funcion (
	id_funcion INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	codigo_pelicula INTEGER NOT NULL,
	codigo_cartelera INTEGER,
	id_horario INTEGER,
	cod_espacio_publicitario INTEGER,
	tipo_pelicula tipo_sala NOT NULL,
	idioma VARCHAR(20) NOT NULL,
	CONSTRAINT funcion_pelicula_fk FOREIGN KEY (codigo_pelicula)
	REFERENCES pelicula(codigo_pelicula)
	ON UPDATE CASCADE ON DELETE CASCADE,
	/* si se elimina la pelicula, se elimina la funcion */
	CONSTRAINT funcion_cartelera_fk FOREIGN KEY (codigo_cartelera)
	REFERENCES cartelera(codigo_cartelera)
	ON UPDATE CASCADE ON DELETE SET NULL,
	/* SI SE ELIMINA DE LA CARTELERA, SIGUE EXISTIENDO LA FUNCION*/
	CONSTRAINT funcion_id_horario_fk FOREIGN KEY (id_horario)
	REFERENCES horario(id_horario)
	ON UPDATE CASCADE ON DELETE CASCADE,
	/*si se elimina el horario, se elimina la funcion*/
	CONSTRAINT funcion_espacioPublicitario_fk FOREIGN KEY (cod_espacio_publicitario)
	REFERENCES espacio_publicitario(cod_espacio_publicitario)
	ON UPDATE CASCADE ON DELETE SET NULL
	/* si se elimina el espacio publicitario, no se elimina la funcion */
);



CREATE TABLE entrada (
	codigo INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	id_funcion INTEGER NOT NULL,
	CONSTRAINT entrada_funcion_fk FOREIGN KEY (id_funcion)
	REFERENCES funcion(id_funcion)
	ON UPDATE CASCADE ON DELETE RESTRICT,
	/* si existen entradas, no se puede eliminar una funcion */
	nro_asiento INTEGER NOT NULL CHECK(nro_asiento > 0),
	entrada tipo_entrada NOT NULL,
	UNIQUE(nro_asiento,id_funcion)
);

-- articulos que vende un kiosko (kiosko y articulo)
CREATE TABLE vende (
	id_vende INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	id_kiosko INTEGER not null REFERENCES kiosko(id_kiosko),
	id_articulo INTEGER not null REFERENCES articulo(id_articulo),
	UNIQUE(id_kiosko,id_articulo)	
);

-- funciones y su respectiva sala (funcion y sala)
CREATE TABLE proyecta (
	nro_sala INTEGER not null REFERENCES sala(nro_sala) ON UPDATE CASCADE ON DELETE CASCADE,
	id_funcion INTEGER not null REFERENCES funcion(id_funcion) ON UPDATE CASCADE ON DELETE CASCADE,
	PRIMARY KEY(nro_sala,id_funcion)
);

-- publicidades de un espacio publicitario
-- ( espacio_publicitario y publicidad )
CREATE TABLE compone (
	id_compone INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	cod_publicidad INTEGER not null REFERENCES publicidad(id_publicidad),
	cod_espacio_publicitario INTEGER not null REFERENCES espacio_publicitario(cod_espacio_publicitario),
	UNIQUE(cod_publicidad,cod_espacio_publicitario)

);

-- cliente y la sucursal/kiosko donde compro (cliente, kiosko)
CREATE TABLE compra_en (
	id_kiosko INTEGER not null REFERENCES kiosko(id_kiosko),
	id_cliente INTEGER not null REFERENCES cliente(id_cliente),
	PRIMARY KEY(id_kiosko,id_cliente)
);

-- empleados que trabajan en el kiosko (kiosko,empleado)
CREATE TABLE trabaja_en (
	id_empleado1 INTEGER not null REFERENCES empleado(legajo) PRIMARY KEY,
	id_empleado2 INTEGER not null REFERENCES empleado(legajo) UNIQUE,
	id_kiosko INTEGER not null REFERENCES kiosko(id_kiosko)
);



-- empleado y las funciones que administra (empleado,funcion)
CREATE TABLE administra_la (
	id_empleado INTEGER not null REFERENCES empleado(legajo),
	id_funcion INTEGER not null REFERENCES funcion(id_funcion),
	PRIMARY KEY(id_empleado,id_funcion)

);

-- clientes y su entrada (cliente,entrada)
CREATE TABLE compra_la (
	id_compra INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	id_cliente INTEGER not null REFERENCES cliente(id_cliente),
	id_entrada INTEGER not null REFERENCES entrada(codigo),
	UNIQUE(id_cliente,id_entrada)
);

-- empleados de limpieza y la sala que limpian (empleado,sala)
CREATE TABLE limpia_la (
	id_empleado INTEGER not null REFERENCES empleado(legajo),
	nro_sala INTEGER not null REFERENCES sala(nro_sala),
	PRIMARY KEY(id_empleado,nro_sala) 
);

--kiosko y sus proveedores
CREATE TABLE Provee(
	id_proveedor INTEGER not null REFERENCES proveedor(id_proveedor),
	id_kiosko INTEGER not null REFERENCES kiosko(id_kiosko),
	PRIMARY KEY(id_proveedor,id_kiosko)
);



-- campos calculados



--Trigger que valida que el número de asiento de la entrada no supere la cantidad de asientos de la sala
CREATE OR REPLACE FUNCTION validar_numero_asiento()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.nro_asiento > (
        SELECT cant_asientos
        FROM sala
        WHERE nro_sala = (
            SELECT nro_sala
            FROM funcion
            JOIN proyecta ON proyecta.id_funcion = NEW.id_funcion
            WHERE proyecta.nro_sala = sala.nro_sala
        )
    ) THEN
        RAISE EXCEPTION 'funcion completa %', NEW.nro_asiento;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger que se ejecuta antes de insertar valores en la tabla entrada
CREATE TRIGGER validar_asiento
BEFORE INSERT OR UPDATE ON entrada
FOR EACH ROW
EXECUTE FUNCTION validar_numero_asiento();


--Trigger que calcula la hora_fin en horario
CREATE OR REPLACE FUNCTION calcular_hora_fin()
RETURNS TRIGGER AS $$
BEGIN
	NEW.hora_fin := (NEW.hora_inicio + (SELECT duracion::INTERVAL
                                    	FROM pelicula
                                    	WHERE codigo_pelicula = NEW.codigo_pelicula
));
	RETURN NEW;
END;
$$
LANGUAGE plpgsql;
--Trigger que se ejecuta cuando se insertan valores en la tabla horario
CREATE TRIGGER trigger_calcular_hora_fin
BEFORE INSERT OR UPDATE ON horario
FOR EACH ROW
EXECUTE FUNCTION calcular_hora_fin();

--Trigeer que verifica que exista al menos una funcion en la cartelera
CREATE OR REPLACE FUNCTION verificar_funciones_en_cartelera()
RETURNS TRIGGER AS $$
BEGIN
	IF NOT EXISTS (SELECT 1
               	FROM funcion
               	WHERE codigo_cartelera = NEW.codigo_cartelera) THEN
    	RAISE EXCEPTION 'La cartelera % no tiene funciones asociadas.', NEW.codigo_cartelera;
	END IF;
	RETURN NEW;
END;
$$ LANGUAGE plpgsql;
--Trigger que se ejecuta cuando se inserta un registro en tabla horario
CREATE TRIGGER trigger_verificar_funciones_en_cartelera
BEFORE INSERT OR UPDATE ON horario
FOR EACH ROW
EXECUTE FUNCTION verificar_funciones_en_cartelera();

--Trigger que calcula que la duracion del espacio publicitario
CREATE OR REPLACE FUNCTION calcular_duracion_espacio_publicitario()
RETURNS TRIGGER AS $$
BEGIN
	UPDATE espacio_publicitario
	SET duracion = (
    	SELECT SUM(p.duracion)
    	FROM publicidad p
    	JOIN compone c ON c.cod_publicidad = p.id_publicidad
    	WHERE c.cod_espacio_publicitario = NEW.cod_espacio_publicitario
	)
	WHERE cod_espacio_publicitario = NEW.cod_espacio_publicitario;
	RETURN NEW;
END;
$$ LANGUAGE plpgsql;
--Trigger que se ejecuta cuando se insertan datos en la tabla compone
CREATE TRIGGER trigger_calcular_duracion_espacio_publicitario
AFTER INSERT OR UPDATE ON compone
FOR EACH ROW
EXECUTE FUNCTION calcular_duracion_espacio_publicitario();

--trigger que calcula la clasificación del espacio publicitario
CREATE OR REPLACE FUNCTION calcular_clasificacion_espacio_publicitario()
RETURNS TRIGGER AS $$
DECLARE
	clasificaciones text[];
	clasificacion_maxima clasificacion_pelicula;
BEGIN
	SELECT ARRAY(SELECT p.clasificacion
             	FROM publicidad p
             	JOIN compone c ON c.cod_publicidad = p.id_publicidad
             	WHERE c.cod_espacio_publicitario = NEW.cod_espacio_publicitario)
	INTO clasificaciones;
	IF array_length(clasificaciones, 1) = 1 THEN
    	clasificacion_maxima := clasificaciones[1];
	ELSE
 	-- 'ATP' < 'P-13' < 'P-16' < 'P-18' < 'P-21'
    	CASE
        	WHEN 'P-21' = ANY(clasificaciones) THEN clasificacion_maxima := 'P-21';
        	WHEN 'P-18' = ANY(clasificaciones) THEN clasificacion_maxima := 'P-18';
        	WHEN 'P-16' = ANY(clasificaciones) THEN clasificacion_maxima := 'P-16';
        	WHEN 'P-13' = ANY(clasificaciones) THEN clasificacion_maxima := 'P-13';
        	ELSE clasificacion_maxima := 'ATP';
    	END CASE;
	END IF;
	UPDATE espacio_publicitario
	SET clasificacion = clasificacion_maxima
	WHERE cod_espacio_publicitario = NEW.cod_espacio_publicitario;
	RETURN NEW;
END;
$$ LANGUAGE plpgsql;

--trigger que se ejecutará después de insertar en la tabla compone
CREATE TRIGGER trigger_calcular_clasificacion_espacio_publicitario
AFTER INSERT OR UPDATE ON compone
FOR EACH ROW
EXECUTE FUNCTION calcular_clasificacion_espacio_publicitario();

